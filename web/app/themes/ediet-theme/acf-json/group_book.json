                                    }
                                },
                                {
                                    "key": "field_book_desc_uc_title",
                                    "label": "Заголовок",
                                    "name": "title",
                                    "type": "text"
                                },
                                {
                                    "key": "field_book_desc_uc_desc",
                                    "label": "Описание",
                                    "name": "desc",
                                    "type": "textarea"
