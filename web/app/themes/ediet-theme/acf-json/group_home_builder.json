{
    "key": "group_front_page_builder",
    "title": "Конструктор Главной Страницы",
    "fields": [
        {
            "key": "field_fp_blocks",
            "label": "Секции страницы",
            "name": "home_blocks",
            "type": "flexible_content",
            "layouts": {
                "layout_hero": {
                    "key": "layout_hero",
                    "name": "hero",
                    "label": "Hero Блок",
                    "display": "block",
                    "sub_fields": [
                        {
                            "key": "field_hero_eyebrow",
                            "label": "Eyebrow Text (Надзаголовок)",
                            "name": "eyebrow",
                            "type": "text",
                            "default_value": "Персональное питание · с 2019"
                        },
                        {
                            "key": "field_hero_title_l1",
                            "label": "Заголовок: Первая строка",
                            "name": "title_line_1",
                            "type": "text",
                            "default_value": "Возьмите здоровье"
                        },
                        {
                            "key": "field_hero_title_l2_pre",
                            "label": "Заголовок: Вторая строка (Начало)",
                            "name": "title_line_2_pre",
                            "type": "text",
                            "default_value": "под"
                        },
                        {
                            "key": "field_hero_title_l2_ital",
                            "label": "Заголовок: Выделенное слово (Italic + Подчеркивание)",
                            "name": "title_line_2_italic",
                            "type": "text",
                            "default_value": "контроль"
                        },
                        {
                            "key": "field_hero_kicker",
                            "label": "Описание (Под заголовком)",
                            "name": "kicker",
                            "type": "textarea",
                            "default_value": "Есть решения под ваш диагноз — персональные протоколы питания, составленные врачами-нутрициологами на основе анализов и медицинской карты."
                        },
                        {
                            "key": "field_hero_cta_1",
                            "label": "Основная кнопка (Найти мой диагноз)",
                            "name": "cta_1",
                            "type": "link"
                        },
                        {
                            "key": "field_hero_cta_2",
                            "label": "Вторая кнопка (Срочная консультация)",
                            "name": "cta_2",
                            "type": "link"
                        },
                        {
                            "key": "field_hero_trust",
                            "label": "Элементы доверия (Trust Items)",
                            "name": "trust_items",
                            "type": "repeater",
                            "sub_fields": [
                                {
                                    "key": "field_hero_trust_text",
                                    "label": "Текст",
                                    "name": "text",
                                    "type": "text",
                                    "instructions": "Используйте <strong> для выделения."
                                }
                            ],
                            "button_label": "Добавить"
                        },
                        {
                            "key": "field_hero_bg_l_num",
                            "label": "Левый Бейдж: Число/Значок",
                            "name": "badge_left_num",
                            "type": "text",
                            "default_value": "26"
                        },
                        {
                            "key": "field_hero_bg_l_k",
                            "label": "Левый Бейдж: Текст сверху",
                            "name": "badge_left_k",
                            "type": "text",
                            "default_value": "диагнозов"
                        },
                        {
                            "key": "field_hero_bg_l_v",
                            "label": "Левый Бейдж: Текст снизу",
                            "name": "badge_left_v",
                            "type": "text",
                            "default_value": "под <em>ключ</em>",
                            "instructions": "Используйте <em> для наклонного текста"
                        },
                        {
                            "key": "field_hero_bg_r_icon",
                            "label": "Правый Бейдж: Иконка/Символ",
                            "name": "badge_right_icon",
                            "type": "text",
                            "default_value": "⟡"
                        },
                        {
                            "key": "field_hero_bg_r_k",
                            "label": "Правый Бейдж: Текст сверху",
                            "name": "badge_right_k",
                            "type": "text",
                            "default_value": "нутрициолог"
                        },
                        {
                            "key": "field_hero_bg_r_v",
                            "label": "Правый Бейдж: Текст снизу",
                            "name": "badge_right_v",
                            "type": "text",
                            "default_value": "<em>онлайн</em> 24/7",
                            "instructions": "Используйте <em> для наклонного текста"
                        },
                        {
                            "key": "field_hero_seal",
                            "label": "Вращающаяся Печать: Текст по кругу",
                            "name": "seal_text",
                            "type": "text",
                            "default_value": "E‑DIET · ЗДОРОВЬЕ В ТАРЕЛКЕ · С 2019 ·"
                        },
                        {
                            "key": "field_hero_seal_cent",
                            "label": "Вращающаяся Печать: Текст в центре",
                            "name": "seal_center",
                            "type": "text",
                            "default_value": "e."
                        }
                    ]
                },
                "layout_categories": {
                    "key": "layout_categories",
                    "name": "categories",
                    "label": "Категории Диагнозов",
                    "display": "block",
                    "sub_fields": [
                        {
                            "key": "field_cat_title",
                            "label": "Заголовок секции",
                            "name": "title",
                            "type": "text"
                        },
                        {
                            "key": "field_cat_items",
                            "label": "Заболевания на Колесе",
                            "name": "items",
                            "type": "relationship",
                            "post_type": [
                                "disease"
                            ],
                            "return_format": "object"
                        }
                    ]
                },
                "layout_featured_products": {
                    "key": "layout_featured_products",
                    "name": "featured_products",
                    "label": "Топ Продукты",
                    "display": "block",
                    "sub_fields": [
                        {
                            "key": "field_prod_title",
                            "label": "Заголовок",
                            "name": "title",
                            "type": "text"
                        },
                        {
                            "key": "field_prod_items",
                            "label": "Продукты / Курсы",
                            "name": "items",
                            "type": "relationship",
                            "post_type": [
                                "book",
                                "course",
                                "service"
                            ],
                            "return_format": "object"
                        }
                    ]
                },
                "layout_expert": {
                    "key": "layout_expert",
                    "name": "expert",
                    "label": "Блок Эксперта",
                    "display": "block",
                    "sub_fields": [
                        {
                            "key": "field_exp_main_title",
                            "label": "Общий Заголовок",
                            "name": "main_title",
                            "type": "text",
                            "default_value": "Почему нам доверяют?"
                        },
                        {
                            "key": "field_exp_main_link",
                            "label": "Ссылка 'О специалистах'",
                            "name": "main_link",
                            "type": "link"
                        },
                        {
                            "key": "field_exp_photo",
                            "label": "Фото Эксперта",
                            "name": "photo",
                            "type": "image",
                            "return_format": "array"
                        },
                        {
                            "key": "field_exp_name",
                            "label": "Имя Эксперта",
                            "name": "name",
                            "type": "text",
                            "default_value": "Dr. Lorem Ipsum"
                        },
                        {
                            "key": "field_exp_role",
                            "label": "Должность",
                            "name": "role",
                            "type": "text",
                            "default_value": "Главный Врач-нутрициолог"
                        },
                        {
                            "key": "field_exp_tag1",
                            "label": "Тег 1",
                            "name": "tag1",
                            "type": "text"
                        },
                        {
                            "key": "field_exp_tag2",
                            "label": "Тег 2",
                            "name": "tag2",
                            "type": "text"
                        },
                        {
                            "key": "field_exp_content_title",
                            "label": "Заголовок текста",
                            "name": "content_title",
                            "type": "text"
                        },
                        {
                            "key": "field_exp_content_text",
                            "label": "Текст",
                            "name": "text",
                            "type": "wysiwyg",
                            "toolbar": "basic"
                        },
                        {
                            "key": "field_exp_quote",
                            "label": "Цитата",
                            "name": "quote",
                            "type": "textarea"
                        },
                        {
                            "key": "field_exp_stats",
                            "label": "Статистика",
                            "name": "stats",
                            "type": "repeater",
                            "layout": "table",
                            "button_label": "Добавить цифру",
                            "sub_fields": [
                                {
                                    "key": "field_exp_stat_v",
                                    "label": "Число",
                                    "name": "value",
                                    "type": "text"
                                },
                                {
                                    "key": "field_exp_stat_l",
                                    "label": "Текст",
                                    "name": "label",
                                    "type": "text"
                                },
                                {
                                    "key": "field_exp_stat_c",
                                    "label": "Цвет значения (HEX)",
                                    "name": "color",
                                    "type": "color_picker",
                                    "default_value": "#2A1A10"
                                }
                            ]
                        }
                    ]
                },
                "layout_narrow_hook": {
                    "key": "layout_narrow_hook",
                    "name": "narrow_hook",
                    "label": "Узкий Хук (Баннер)",
                    "display": "block",
                    "sub_fields": [
                        {
                            "key": "field_nh_icon",
                            "label": "Иконка / Картинка",
                            "name": "icon",
                            "type": "image",
                            "return_format": "array"
                        },
                        {
                            "key": "field_nh_title",
                            "label": "Заголовок",
                            "name": "title",
                            "type": "text"
                        },
                        {
                            "key": "field_nh_subtitle",
                            "label": "Подзаголовок",
                            "name": "subtitle",
                            "type": "text"
                        },
                        {
                            "key": "field_nh_text",
                            "label": "Текст",
                            "name": "text",
                            "type": "textarea"
                        },
                        {
                            "key": "field_nh_btn",
                            "label": "Кнопка",
                            "name": "btn",
                            "type": "link"
                        }
                    ]
                },
                "layout_reviews": {
                    "key": "layout_reviews",
                    "name": "featured_reviews",
                    "label": "Отзывы",
                    "display": "block",
                    "sub_fields": [
                        {
                            "key": "field_rev_title",
                            "label": "Заголовок",
                            "name": "title",
                            "type": "text"
                        },
                        {
                            "key": "field_rev_items",
                            "label": "Выбранные Отзывы",
                            "name": "items",
                            "type": "relationship",
                            "post_type": [
                                "review"
                            ],
                            "return_format": "object"
                        }
                    ]
                },
                "layout_quiz": {
                    "key": "layout_quiz",
                    "name": "quiz_banner",
                    "label": "Квиз Баннер",
                    "display": "block",
                    "sub_fields": [
                        {
                            "key": "field_quiz_title",
                            "label": "Заголовок",
                            "name": "title",
                            "type": "text"
                        },
                        {
                            "key": "field_quiz_subtitle",
                            "label": "Подзаголовок",
                            "name": "subtitle",
                            "type": "text"
                        },
                        {
                            "key": "field_quiz_form_id",
                            "label": "ID Формы / Шорткод",
                            "name": "form_id",
                            "type": "text"
                        }
                    ]
                }
            },
            "button_label": "Добавить секцию на Главную"
        }
    ],
    "location": [
        [
            {
                "param": "post_type",
                "operator": "==",
                "value": "page"
            },
            {
                "param": "page_type",
                "operator": "==",
                "value": "front_page"
            }
        ]
    ],
    "active": true
}